<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Master Admin Console - NotesHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-container">
        <!-- Master Stats Row -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon sky">👨‍🎓</div>
                <div class="stat-content">
                    <h3><%= stats.studentCount %></h3>
                    <p>Total Students</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon indigo">👨‍🏫</div>
                <div class="stat-content">
                    <h3><%= stats.teacherCount %></h3>
                    <p>Total Faculty</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon emerald">📚</div>
                <div class="stat-content">
                    <h3><%= stats.subjectCount %></h3>
                    <p>Active Courses</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon amber">📝</div>
                <div class="stat-content">
                    <h3><%= stats.noteCount %></h3>
                    <p>Notes Published</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: #ede9fe; color: #7c3aed;">📊</div>
                <div class="stat-content">
                    <h3><%= stats.resultCount %></h3>
                    <p>Published Results</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: #fee2e2; color: #dc2626;">❓</div>
                <div class="stat-content">
                    <h3><%= stats.pendingDoubts %></h3>
                    <p>Pending Doubts</p>
                </div>
            </div>
        </div>

        <!-- Master Toolbar Tabs -->
        <div class="dashboard-toolbar">
            <div style="font-weight: 800; font-size: 1.15rem; color: var(--dark); display: flex; align-items: center; gap: 0.5rem;">
                <span>🛡️ System Administration</span>
            </div>
            <div class="tab-nav">
                <button class="tab-btn active" data-tab="tab-students">👨‍🎓 Students (<%= students.length %>)</button>
                <button class="tab-btn" data-tab="tab-teachers">👨‍🏫 Teachers (<%= teachers.length %>)</button>
                <button class="tab-btn" data-tab="tab-subjects">📚 Courses (<%= subjects.length %>)</button>
                <button class="tab-btn" data-tab="tab-timetable">📅 Timetables</button>
                <button class="tab-btn" data-tab="tab-results">📊 Results (<%= results.length %>)</button>
                <button class="tab-btn" data-tab="tab-moderation">🗂️ Moderation</button>
            </div>
        </div>

        <!-- TAB 1: STUDENTS MANAGEMENT -->
        <div id="tab-students" class="tab-pane active">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <!-- Students Table -->
                <div class="glass-panel" style="overflow-x: auto;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Registered Students (Showing first <%= students.length %>)
                    </h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                        <thead>
                            <tr style="text-align: left; border-bottom: 2px solid var(--gray-200); color: var(--gray-600);">
                                <th style="padding: 0.6rem;">Roll No</th>
                                <th style="padding: 0.6rem;">Name</th>
                                <th style="padding: 0.6rem;">Section</th>
                                <th style="padding: 0.6rem; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(s => { %>
                                <tr style="border-bottom: 1px solid var(--gray-100);">
                                    <td style="padding: 0.6rem; font-family: var(--font-mono); font-weight: 700;"><%= s.rollNumber %></td>
                                    <td style="padding: 0.6rem;"><%= s.name %></td>
                                    <td style="padding: 0.6rem;"><span class="note-section-pill">Sec <%= s.section %></span></td>
                                    <td style="padding: 0.6rem; text-align: right;">
                                        <form method="POST" action="/admin/student/delete/<%= s._id %>" style="display: inline;" onsubmit="return confirm('Delete student <%= s.rollNumber %>?');">
                                            <button type="submit" class="btn-delete-note" title="Delete Student">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Add Student Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        ➕ Add New Student
                    </h4>
                    <form method="POST" action="/admin/student">
                        <div class="form-group">
                            <label class="form-label">Roll Number</label>
                            <input type="text" name="rollNumber" class="form-control" placeholder="e.g. S3001" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Alex Johnson" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Initial Password" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Section</label>
                            <select name="section" class="form-control" required>
                                <option value="A">Section A</option>
                                <option value="B">Section B</option>
                                <option value="C">Section C</option>
                                <option value="D">Section D</option>
                                <option value="E">Section E</option>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem;">
                            Create Student Account
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 2: TEACHERS MANAGEMENT -->
        <div id="tab-teachers" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <!-- Teachers Table -->
                <div class="glass-panel" style="overflow-x: auto;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Faculty Members (<%= teachers.length %>)
                    </h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                        <thead>
                            <tr style="text-align: left; border-bottom: 2px solid var(--gray-200); color: var(--gray-600);">
                                <th style="padding: 0.6rem;">Faculty ID</th>
                                <th style="padding: 0.6rem;">Name</th>
                                <th style="padding: 0.6rem;">Role</th>
                                <th style="padding: 0.6rem; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% teachers.forEach(t => { %>
                                <tr style="border-bottom: 1px solid var(--gray-100);">
                                    <td style="padding: 0.6rem; font-family: var(--font-mono); font-weight: 700;"><%= t.rollNumber %></td>
                                    <td style="padding: 0.6rem;"><%= t.name %></td>
                                    <td style="padding: 0.6rem;"><span class="user-role-badge teacher">Faculty</span></td>
                                    <td style="padding: 0.6rem; text-align: right;">
                                        <form method="POST" action="/admin/teacher/delete/<%= t._id %>" style="display: inline;" onsubmit="return confirm('Delete teacher <%= t.name %>?');">
                                            <button type="submit" class="btn-delete-note" title="Delete Faculty">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Add Teacher Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        ➕ Add New Faculty
                    </h4>
                    <form method="POST" action="/admin/teacher">
                        <div class="form-group">
                            <label class="form-label">Faculty ID</label>
                            <input type="text" name="rollNumber" class="form-control" placeholder="e.g. T002" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Full Name</label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Prof. Alan Turing" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Password</label>
                            <input type="password" name="password" class="form-control" placeholder="Initial Password" required>
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem; background: var(--gradient-teacher);">
                            Create Faculty Account
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 3: SUBJECTS MANAGEMENT -->
        <div id="tab-subjects" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <div class="glass-panel" style="overflow-x: auto;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Active Courses (<%= subjects.length %>)
                    </h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                        <thead>
                            <tr style="text-align: left; border-bottom: 2px solid var(--gray-200); color: var(--gray-600);">
                                <th style="padding: 0.6rem;">Code</th>
                                <th style="padding: 0.6rem;">Course Name</th>
                                <th style="padding: 0.6rem;">Sections</th>
                                <th style="padding: 0.6rem;">Faculty</th>
                                <th style="padding: 0.6rem; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% subjects.forEach(sub => { %>
                                <tr style="border-bottom: 1px solid var(--gray-100);">
                                    <td style="padding: 0.6rem; font-weight: 700;"><%= sub.code %></td>
                                    <td style="padding: 0.6rem;"><%= sub.name %></td>
                                    <td style="padding: 0.6rem;"><%= sub.sections.join(', ') %></td>
                                    <td style="padding: 0.6rem;"><%= sub.teacher ? sub.teacher.name : 'Unassigned' %></td>
                                    <td style="padding: 0.6rem; text-align: right;">
                                        <form method="POST" action="/admin/subject/delete/<%= sub._id %>" style="display: inline;" onsubmit="return confirm('Delete course <%= sub.code %>?');">
                                            <button type="submit" class="btn-delete-note" title="Delete Course">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Add Subject Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        ➕ Create Course
                    </h4>
                    <form method="POST" action="/admin/subject">
                        <div class="form-group">
                            <label class="form-label">Course Code</label>
                            <input type="text" name="code" class="form-control" placeholder="e.g. CS205" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Course Name</label>
                            <input type="text" name="name" class="form-control" placeholder="e.g. Cloud Computing" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Sections (Comma Separated)</label>
                            <input type="text" name="sections" class="form-control" placeholder="A, B, C, D, E" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Assign Faculty</label>
                            <select name="teacherId" class="form-control">
                                <option value="">-- Select Faculty (Optional) --</option>
                                <% teachers.forEach(t => { %>
                                    <option value="<%= t._id %>"><%= t.name %> (<%= t.rollNumber %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem;">
                            Publish Course
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 4: TIMETABLE MANAGEMENT -->
        <div id="tab-timetable" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <!-- Existing Schedules View -->
                <div class="glass-panel">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Section Weekly Schedules (<%= timetables.length %> days scheduled)
                    </h3>
                    <% if (timetables.length === 0) { %>
                        <div class="empty-box">
                            <div class="empty-box-icon">📅</div>
                            <h4>No timetable schedules registered yet</h4>
                            <p>Use the form on the right to schedule classes for student sections.</p>
                        </div>
                    <% } else { %>
                        <% timetables.forEach(t => { %>
                            <div style="border: 1px solid var(--gray-200); border-radius: var(--radius-sm); padding: 1rem; margin-bottom: 1rem; background: var(--gray-50);">
                                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                                    <h4 style="font-weight: 800; font-size: 1rem; color: var(--primary);">
                                        Section <%= t.section %> — <%= t.day %>
                                    </h4>
                                    <form method="POST" action="/admin/timetable/delete/<%= t._id %>" style="display: inline;" onsubmit="return confirm('Delete timetable for Section <%= t.section %> on <%= t.day %>?');">
                                        <button type="submit" class="btn-delete-note">Delete Day Schedule</button>
                                    </form>
                                </div>
                                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 0.75rem;">
                                    <% t.slots.forEach(slot => { %>
                                        <div style="background: white; border: 1px solid var(--gray-200); border-radius: var(--radius-sm); padding: 0.6rem;">
                                            <div style="font-weight: 700; font-size: 0.82rem; color: var(--dark);">
                                                Period <%= slot.period %> (<%= slot.startTime %> - <%= slot.endTime %>)
                                            </div>
                                            <div style="color: var(--primary); font-size: 0.85rem; font-weight: 600;">
                                                <%= slot.subject ? `${slot.subject.code} - ${slot.subject.name}` : 'Subject' %>
                                            </div>
                                            <div style="font-size: 0.78rem; color: var(--gray-600);">
                                                👨‍🏫 <%= slot.teacher ? slot.teacher.name : 'Faculty' %> • 📍 <%= slot.room %>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>

                <!-- Add Slot Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        ➕ Add Timetable Slot
                    </h4>
                    <form method="POST" action="/admin/timetable/slot">
                        <div class="form-group">
                            <label class="form-label">Section</label>
                            <select name="section" class="form-control" required>
                                <option value="A">Section A</option>
                                <option value="B">Section B</option>
                                <option value="C">Section C</option>
                                <option value="D">Section D</option>
                                <option value="E">Section E</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Day of Week</label>
                            <select name="day" class="form-control" required>
                                <option value="Monday">Monday</option>
                                <option value="Tuesday">Tuesday</option>
                                <option value="Wednesday">Wednesday</option>
                                <option value="Thursday">Thursday</option>
                                <option value="Friday">Friday</option>
                                <option value="Saturday">Saturday</option>
                            </select>
                        </div>
                        <div class="form-grid-2">
                            <div class="form-group">
                                <label class="form-label">Period #</label>
                                <input type="number" name="period" class="form-control" placeholder="1" min="1" max="10" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Room</label>
                                <input type="text" name="room" class="form-control" placeholder="Lab 1 / Hall 201" required>
                            </div>
                        </div>
                        <div class="form-grid-2">
                            <div class="form-group">
                                <label class="form-label">Start Time</label>
                                <input type="text" name="startTime" class="form-control" placeholder="09:00 AM" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">End Time</label>
                                <input type="text" name="endTime" class="form-control" placeholder="10:00 AM" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Course / Subject</label>
                            <select name="subjectId" class="form-control" required>
                                <option value="">-- Choose Subject --</option>
                                <% subjects.forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.code %> - <%= s.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Faculty Member</label>
                            <select name="teacherId" class="form-control">
                                <option value="">-- Choose Faculty (Optional) --</option>
                                <% teachers.forEach(t => { %>
                                    <option value="<%= t._id %>"><%= t.name %> (<%= t.rollNumber %>)</option>
                                <% }) %>
                            </select>
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem;">
                            Save Timetable Slot
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 5: RESULTS MANAGEMENT -->
        <div id="tab-results" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <!-- Published Results Table -->
                <div class="glass-panel" style="overflow-x: auto;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Published Student Results (<%= results.length %>)
                    </h3>
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                        <thead>
                            <tr style="text-align: left; border-bottom: 2px solid var(--gray-200); color: var(--gray-600);">
                                <th style="padding: 0.6rem;">Student</th>
                                <th style="padding: 0.6rem;">Course</th>
                                <th style="padding: 0.6rem;">Exam</th>
                                <th style="padding: 0.6rem;">Score</th>
                                <th style="padding: 0.6rem;">Grade</th>
                                <th style="padding: 0.6rem; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% results.forEach(r => { %>
                                <tr style="border-bottom: 1px solid var(--gray-100);">
                                    <td style="padding: 0.6rem;">
                                        <strong><%= r.student ? r.student.name : 'Unknown' %></strong>
                                        <div style="font-size: 0.78rem; color: var(--gray-400);"><%= r.student ? r.student.rollNumber : '' %> (Sec <%= r.student ? r.student.section : '' %>)</div>
                                    </td>
                                    <td style="padding: 0.6rem;"><%= r.subject ? r.subject.code : '' %></td>
                                    <td style="padding: 0.6rem;"><%= r.examName %></td>
                                    <td style="padding: 0.6rem; font-weight: 700;"><%= r.marksObtained %> / <%= r.maxMarks %></td>
                                    <td style="padding: 0.6rem;">
                                        <span class="user-role-badge <%= r.grade === 'F' ? 'admin' : 'student' %>"><%= r.grade %></span>
                                    </td>
                                    <td style="padding: 0.6rem; text-align: right;">
                                        <form method="POST" action="/admin/result/delete/<%= r._id %>" style="display: inline;" onsubmit="return confirm('Delete this result record?');">
                                            <button type="submit" class="btn-delete-note">🗑️</button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Publish Result Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        📊 Publish Student Result
                    </h4>
                    <form method="POST" action="/admin/result">
                        <div class="form-group">
                            <label class="form-label">Student Roll Number</label>
                            <input type="text" name="rollNumber" class="form-control" placeholder="e.g. S0001" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Course / Subject</label>
                            <select name="subjectId" class="form-control" required>
                                <option value="">-- Choose Subject --</option>
                                <% subjects.forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.code %> - <%= s.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Exam Name</label>
                            <input type="text" name="examName" class="form-control" placeholder="e.g. Mid-Term Examination 2026" required>
                        </div>
                        <div class="form-grid-2">
                            <div class="form-group">
                                <label class="form-label">Marks Scored</label>
                                <input type="number" step="0.5" name="marksObtained" class="form-control" placeholder="85" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Max Marks</label>
                                <input type="number" step="1" name="maxMarks" class="form-control" placeholder="100" value="100" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Remarks</label>
                            <input type="text" name="remarks" class="form-control" placeholder="e.g. Excellent conceptual clarity">
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem;">
                            Publish Result Record
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 6: MODERATION -->
        <div id="tab-moderation" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                <!-- Recent Notes Moderation -->
                <div class="glass-panel">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Recent Notes Published (<%= notes.length %>)
                    </h3>
                    <% notes.forEach(n => { %>
                        <div style="border-bottom: 1px solid var(--gray-200); padding: 0.75rem 0; display: flex; justify-content: space-between; align-items: center;">
                            <div>
                                <div style="font-weight: 700; color: var(--dark);"><%= n.title %></div>
                                <div style="font-size: 0.78rem; color: var(--gray-600);">
                                    <%= n.subject ? n.subject.code : '' %> • Sec <%= n.section %> • By: <%= n.uploadedBy ? n.uploadedBy.name : 'Faculty' %>
                                </div>
                            </div>
                            <% if (n.fileUrl) { %>
                                <a href="<%= n.fileUrl %>" class="btn-download-note" download style="font-size: 0.75rem; padding: 0.3rem 0.6rem;">⬇️ File</a>
                            <% } %>
                        </div>
                    <% }) %>
                </div>

                <!-- Recent Doubts Moderation -->
                <div class="glass-panel">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Recent Student Doubts (<%= doubts.length %>)
                    </h3>
                    <% doubts.forEach(d => { %>
                        <div style="border-bottom: 1px solid var(--gray-200); padding: 0.75rem 0;">
                            <div style="display: flex; justify-content: space-between; margin-bottom: 0.25rem;">
                                <span style="font-weight: 700; font-size: 0.85rem;"><%= d.student ? d.student.name : 'Student' %> (<%= d.student ? d.student.rollNumber : '' %>)</span>
                                <span class="doubt-status-pill <%= d.status %>"><%= d.status %></span>
                            </div>
                            <div style="font-size: 0.85rem; color: var(--dark-muted);"><%= d.message %></div>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
