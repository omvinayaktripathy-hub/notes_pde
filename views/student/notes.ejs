<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject ? subject.name : 'Subject Notes' %> - NotesHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <a href="/student/dashboard" class="back-to-home" style="margin-bottom: 0.5rem;">← Back to Dashboard</a>
                <h1 style="font-size: 1.75rem; font-weight: 800; color: var(--dark);">
                    📚 <%= subject ? `${subject.code}: ${subject.name}` : 'Subject Notes' %>
                </h1>
                <p style="color: var(--gray-600); font-size: 0.9rem;">
                    Course notes and materials filtered for Section <strong><%= user.section %></strong>
                </p>
            </div>
        </div>

        <% if (notes.length === 0) { %>
            <div class="empty-box">
                <div class="empty-box-icon">📭</div>
                <h4>No materials uploaded yet for this subject</h4>
                <p>Check back later or ask your professor in the doubts section.</p>
                <a href="/student/dashboard#tab-ask" class="btn-primary-glow" style="display: inline-flex; width: auto; margin-top: 1.5rem;">
                    Ask Question to Teacher →
                </a>
            </div>
        <% } else { %>
            <div class="notes-grid">
                <% notes.forEach(note => { %>
                    <div class="note-item-card">
                        <div>
                            <div class="note-header">
                                <span class="note-subject-pill"><%= subject ? subject.code : 'Note' %></span>
                                <span class="note-section-pill">Sec <%= note.section %></span>
                            </div>
                            <h3 class="note-title"><%= note.title %></h3>
                            <p class="note-desc"><%= note.description || 'No detailed description.' %></p>
                        </div>
                        <div class="note-footer">
                            <div>
                                <span>📅 <%= new Date(note.createdAt).toLocaleDateString() %></span>
                                <% if (note.fileType) { %>
                                    <span style="margin-left: 0.4rem; font-weight: 700; color: var(--primary);">[<%= note.fileType %>]</span>
                                <% } %>
                            </div>
                            <% if (note.fileUrl) { %>
                                <a href="<%= note.fileUrl %>" class="btn-download-note" download="<%= note.originalName || '' %>">
                                    <span>⬇️ Download</span>
                                </a>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
