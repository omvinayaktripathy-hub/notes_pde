<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard - Notes Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="modern-navbar">
        <div class="container">
            <a href="/student/dashboard" class="brand">
                <span class="brand-icon">📚</span>
                <span>Student Dashboard</span>
            </a>
            <div class="nav-user">
                <div class="user-badge"><span>👤</span><span><%= user.name %></span></div>
                <div class="user-badge"><span>📚</span><span>Section <%= user.section %></span></div>
                <a href="/logout" class="btn-logout">🚪 Logout</a>
            </div>
        </div>
    </nav>

    <div class="dashboard-container">
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon blue">📖</div>
                <div class="stat-content"><h3><%= subjects.length %></h3><p>Your Subjects</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon pink">📝</div>
                <div class="stat-content"><h3><%= notes.length %></h3><p>Available Notes</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon green">📚</div>
                <div class="stat-content"><h3><%= user.section %></h3><p>Your Section</p></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon orange">👤</div>
                <div class="stat-content"><h3><%= user.rollNumber %></h3><p>Roll Number</p></div>
            </div>
        </div>

        <div class="section-header">
            <h2 class="section-title">
                <span class="section-title-icon">📚</span>
                Your Subjects
            </h2>
        </div>
        <div class="grid-subjects">
            <% subjects.forEach(subject => { %>
                <div class="card-subject">
                    <span class="subject-code"><%= subject.code %></span>
                    <h5><%= subject.name %></h5>
                    <a href="/student/notes/<%= subject._id %>" class="btn-gradient" style="margin-top: 1rem; font-size: 0.875rem;">View Notes →</a>
                </div>
            <% }) %>
        </div>

        <div class="section-header" style="margin-top: 3rem;">
            <h2 class="section-title">
                <span class="section-title-icon">📝</span>
                Recent Notes
            </h2>
        </div>
        <% if (notes.length === 0) { %>
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <h3>No notes available yet</h3>
                <p>Check back later for updates.</p>
            </div>
        <% } else { %>
            <div class="grid-notes">
                <% notes.forEach(note => { %>
                    <div class="note-card">
                        <span class="subject-tag"><%= note.subject.name %></span>
                        <h5><%= note.title %></h5>
                        <p class="note-desc"><%= note.description %></p>
                        <small class="note-date">📅 <%= new Date(note.createdAt).toLocaleDateString() %></small>
                        <% if (note.fileUrl) { %>
                            <a href="<%= note.fileUrl %>" class="btn-success-custom" style="font-size: 0.875rem; padding: 0.5rem 1rem;" download>⬇️ Download</a>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <div class="form-section" style="margin-top: 3rem;">
            <h3>❓ Ask a Doubt</h3>
            <form method="POST" action="/student/notification">
                <div class="form-group-modern">
                    <label>📖 Subject</label>
                    <select name="subjectId" class="form-control-modern" required>
                        <option value="">-- Select a Subject --</option>
                        <% subjects.forEach(subject => { %>
                            <option value="<%= subject._id %>"><%= subject.code %> - <%= subject.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div class="form-group-modern">
                    <label>💬 Your Question</label>
                    <textarea name="message" class="form-control-modern" rows="4" placeholder="Describe your doubt in detail..." required></textarea>
                </div>
                <button type="submit" class="btn-warning-custom">📤 Send to Teacher</button>
            </form>
        </div>
    </div>
</body>
</html>
