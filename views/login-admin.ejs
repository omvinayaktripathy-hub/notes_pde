<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Master Administrator Console - NotesHub</title>
    <meta name="description" content="Central administration console for university IT administrators to manage students, faculty accounts, course assignments, timetables, and system audits.">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.svg">

    <!-- Fonts & Stylesheet -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-login admin-theme">
    <%- include('partials/alerts') %>

    <div class="admin-page-wrap">
        <div class="admin-terminal-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                <!-- Clickable Logo / Escape link -->
                <a href="/" class="brand" style="font-size: 1.15rem;" title="Campus Home">
                    <span class="brand-logo-icon">📚</span>
                    <span class="brand-text" style="color: white;">Notes<span class="brand-highlight">Hub</span></span>
                </a>
                <div class="admin-status-indicator">
                    <span class="pulse-dot"></span>
                    <span>ROOT_SYS_ONLINE</span>
                </div>
            </div>

            <div style="text-align: center; margin-bottom: 1.75rem;">
                <div style="font-size: 2.5rem; margin-bottom: 0.5rem; filter: drop-shadow(0 0 15px rgba(239, 68, 68, 0.6));">🛡️</div>
                <h2 style="font-size: 1.5rem; font-weight: 800; color: #ffffff; font-family: var(--font-mono); letter-spacing: -0.02em;">
                    MASTER_ADMIN_CONSOLE
                </h2>
                <p style="color: #94a3b8; font-size: 0.82rem; font-family: var(--font-mono); margin-top: 0.35rem;">
                    [SECURE_COMMAND_INTERFACE]
                </p>
            </div>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="toast-alert toast-error" style="position: static; margin-bottom: 1.5rem; background: rgba(220, 38, 38, 0.2); border-color: #ef4444; color: #fca5a5; font-family: var(--font-mono); font-size: 0.82rem; width: 100%;">
                    <span>⚠️</span>
                    <span>ACCESS_DENIED: <%= error %></span>
                </div>
            <% } %>

            <form method="POST" action="/login/admin" id="admin-form">
                <div class="form-group">
                    <label class="form-label" for="rollNumber" style="color: #cbd5e1; font-family: var(--font-mono); font-size: 0.8rem;">
                        ADMIN_IDENTIFIER &gt;
                    </label>
                    <input type="text" id="rollNumber" name="rollNumber" class="form-control admin-input" placeholder="ADMIN01" autocomplete="username" required autofocus>
                </div>

                <div class="form-group">
                    <label class="form-label" for="password" style="color: #cbd5e1; font-family: var(--font-mono); font-size: 0.8rem;">
                        PASSPHRASE &gt;
                    </label>
                    <input type="password" id="password" name="password" class="form-control admin-input" placeholder="••••••••••••" autocomplete="current-password" required>
                </div>

                <button type="submit" class="btn-admin-submit" style="margin-top: 1.5rem;">
                    INITIALIZE COMMAND SESSION &gt;&gt;
                </button>
            </form>

            <div style="margin-top: 1.5rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(255, 255, 255, 0.1); padding-top: 1rem; flex-wrap: wrap; gap: 0.5rem;">
                <button type="button" class="quick-fill-chip dark" onclick="document.getElementById('rollNumber').value='ADMIN01'; document.getElementById('password').value='admin123';" style="border-color: rgba(239, 68, 68, 0.4); color: #fca5a5; font-family: var(--font-mono);">
                    ⚡ Demo Admin (ADMIN01)
                </button>
                <div style="font-size: 0.75rem; color: #64748b; font-family: var(--font-mono);">
                    TLS 1.3 ENCRYPTED
                </div>
            </div>

            <div style="margin-top: 1.25rem; font-size: 0.72rem; color: #64748b; text-align: center; font-family: var(--font-mono);">
                ⚠️ WARNING: All administrative modifications and queries are logged in system audit logs.
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
