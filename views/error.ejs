<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Error' %> - Notes Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="welcome-page">
        <div class="welcome-container" style="max-width: 500px; text-align: center;">
            <div style="font-size: 4rem; margin-bottom: 1rem;">⚠️</div>
            <h2><%= typeof title !== 'undefined' ? title : 'Notice' %></h2>
            <p style="color: var(--gray); margin: 1rem 0 2rem;"><%= typeof message !== 'undefined' ? message : 'An error occurred.' %></p>
            <a href="/" class="btn-primary-glow" style="display: inline-block;">Return to Safety →</a>
        </div>
    </div>
</body>
</html>
