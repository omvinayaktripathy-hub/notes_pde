<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Login - NotesHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <a href="/" class="back-to-home">← Back to Home</a>

            <div class="auth-header">
                <div class="auth-icon-badge teacher">👨‍🏫</div>
                <h2 class="auth-title">Faculty Portal</h2>
                <p class="auth-subtitle">Sign in to manage subjects, upload notes, and resolve student doubts</p>
            </div>

            <% if (error) { %>
                <div class="toast-alert toast-error" style="position: static; margin-bottom: 1.25rem;">
                    <span>⚠️</span>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form method="POST" action="/login/teacher">
                <div class="form-group">
                    <label class="form-label" for="rollNumber">Faculty ID (e.g. T001)</label>
                    <input type="text" id="rollNumber" name="rollNumber" class="form-control" placeholder="Enter Faculty ID (e.g. T001)" required autofocus>
                </div>
                <div class="form-group">
                    <label class="form-label" for="password">Password</label>
                    <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
                <button type="submit" class="btn-primary-glow" style="margin-top: 1.5rem; background: var(--gradient-teacher);">
                    <span>Sign In to Faculty Portal</span> →
                </button>
            </form>

            <div style="margin-top: 1.75rem; padding-top: 1.25rem; border-top: 1px solid var(--gray-200); text-align: center; font-size: 0.82rem; color: var(--gray-600);">
                Are you a student? <a href="/login/student" style="color: var(--primary); font-weight: 700; text-decoration: none;">Student Login →</a>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
