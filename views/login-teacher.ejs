<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Faculty Portal Login - NotesHub</title>
    <meta name="description" content="Instructor console for university faculty to upload course notes, verify weekly class schedules, publish examination marks, and resolve student questions.">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.svg">

    <!-- Fonts & Stylesheet -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-login">
    <%- include('partials/alerts') %>

    <div class="teacher-page-wrap">
        <div class="teacher-portal-box">
            <!-- Left Academic Faculty Hero Side -->
            <div class="teacher-hero-side">
                <div>
                    <!-- Clickable Logo / Back link -->
                    <a href="/" class="login-back-brand light" title="Return to Campus Home">
                        <span class="brand-logo-icon">📚</span>
                        <span class="brand-text">Notes<span class="brand-highlight">Hub</span></span>
                    </a>

                    <div style="font-size: 2.8rem; margin: 1.25rem 0 0.75rem;">👨‍🏫</div>
                    <h2 style="font-size: 1.85rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.75rem;">
                        Academic Faculty Portal
                    </h2>
                    <p style="color: #cbd5e1; font-size: 0.92rem; line-height: 1.6;">
                        Secure instructional console for university professors to distribute study materials, verify classroom slots, grade assessments, and guide students.
                    </p>

                    <div style="margin: 1.75rem 0; display: flex; flex-direction: column; gap: 0.85rem;">
                        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; color: #e2e8f0;">
                            <span style="background: rgba(168, 85, 247, 0.3); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem;">📤</span>
                            <span>Upload Lecture Notes (PDF, DOCX, Code)</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; color: #e2e8f0;">
                            <span style="background: rgba(168, 85, 247, 0.3); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem;">📅</span>
                            <span>View Teaching Timetable &amp; Lecture Halls</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; color: #e2e8f0;">
                            <span style="background: rgba(168, 85, 247, 0.3); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem;">📊</span>
                            <span>Publish Examination Results &amp; Grades</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem; font-size: 0.88rem; color: #e2e8f0;">
                            <span style="background: rgba(168, 85, 247, 0.3); padding: 0.3rem 0.6rem; border-radius: var(--radius-sm); font-size: 0.8rem;">💬</span>
                            <span>Review &amp; Answer Student Academic Inquiries</span>
                        </div>
                    </div>
                </div>

                <div class="login-left-footer light">
                    <span>🔒 Authorized University Academic Faculty Only</span>
                </div>
            </div>

            <!-- Right Faculty Login Form Side -->
            <div class="teacher-form-side">
                <div style="margin-bottom: 1.75rem;">
                    <span style="font-size: 0.78rem; font-weight: 700; color: #a855f7; text-transform: uppercase; letter-spacing: 0.05em;">Instructor Verification</span>
                    <h3 style="font-size: 1.65rem; font-weight: 800; color: white; margin-top: 0.25rem;">Faculty Sign In</h3>
                    <p style="color: #94a3b8; font-size: 0.88rem;">Authenticate with your unique Faculty ID credentials.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="toast-alert toast-error" style="position: static; margin-bottom: 1.25rem; width: 100%;">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form method="POST" action="/login/teacher" id="teacher-form">
                    <div class="form-group">
                        <label class="form-label" for="rollNumber" style="color: #cbd5e1;">Faculty Identifier</label>
                        <input type="text" id="rollNumber" name="rollNumber" class="form-control teacher-input" placeholder="e.g. T001" autocomplete="username" required autofocus>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password" style="color: #cbd5e1;">Password</label>
                        <input type="password" id="password" name="password" class="form-control teacher-input" placeholder="••••••••••••" autocomplete="current-password" required>
                    </div>

                    <button type="submit" class="btn-teacher-submit">
                        Access Faculty Control Center →
                    </button>
                </form>

                <div class="login-quick-fill-container">
                    <button type="button" class="quick-fill-chip dark" onclick="document.getElementById('rollNumber').value='T001'; document.getElementById('password').value='teacher123';">
                        ⚡ Quick Fill Demo Faculty (T001)
                    </button>
                </div>

                <div class="login-alternate-links light">
                    <span>Student login? <a href="/login/student" class="auth-text-link light">Student Portal →</a></span>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
