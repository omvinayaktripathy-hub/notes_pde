<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Faculty Dashboard - NotesHub</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('../partials/navbar') %>
    <%- include('../partials/alerts') %>

    <div class="dashboard-container">
        <!-- Stats Row -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon indigo">📚</div>
                <div class="stat-content">
                    <h3><%= stats.totalSubjects %></h3>
                    <p>Your Courses</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon sky">📤</div>
                <div class="stat-content">
                    <h3><%= stats.totalNotes %></h3>
                    <p>Notes Published</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon amber">❓</div>
                <div class="stat-content">
                    <h3><%= stats.pendingDoubts %></h3>
                    <p>Pending Questions</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background: #ede9fe; color: #7c3aed;">📊</div>
                <div class="stat-content">
                    <h3><%= stats.publishedResults %></h3>
                    <p>Grades Published</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon emerald">✓</div>
                <div class="stat-content">
                    <h3><%= stats.resolvedDoubts %></h3>
                    <p>Resolved Doubts</p>
                </div>
            </div>
        </div>

        <!-- Toolbar with Tabs -->
        <div class="dashboard-toolbar">
            <div style="font-weight: 700; color: var(--dark); font-size: 1.1rem;">
                👨‍🏫 Faculty Control Center
            </div>
            <div class="tab-nav">
                <button class="tab-btn active" data-tab="tab-doubts">❓ Doubts (<%= notifications.length %>)</button>
                <button class="tab-btn" data-tab="tab-upload">📤 Upload Note</button>
                <button class="tab-btn" data-tab="tab-manage-notes">📑 Notes (<%= notes.length %>)</button>
                <button class="tab-btn" data-tab="tab-schedule">📅 My Schedule</button>
                <button class="tab-btn" data-tab="tab-results">📊 Results</button>
                <button class="tab-btn" data-tab="tab-add-subject">➕ Subject</button>
                <button class="tab-btn" data-tab="tab-resolved">🗃️ Resolved</button>
            </div>
        </div>

        <!-- TAB 1: PENDING DOUBTS -->
        <div id="tab-doubts" class="tab-pane active">
            <div style="margin-bottom: 1.25rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--dark);">
                    Pending Student Doubts & Questions
                </h3>
                <p style="color: var(--gray-600); font-size: 0.88rem;">
                    Questions submitted by students enrolled in your courses. Type an answer to resolve and notify them.
                </p>
            </div>

            <% if (notifications.length === 0) { %>
                <div class="empty-box">
                    <div class="empty-box-icon">🎉</div>
                    <h4>No pending doubts!</h4>
                    <p>All student questions in your courses have been addressed.</p>
                </div>
            <% } else { %>
                <% notifications.forEach(item => { %>
                    <div class="doubt-card">
                        <div class="doubt-header">
                            <div class="doubt-student-info">
                                <span>👤 <%= item.student ? item.student.name : 'Unknown Student' %></span>
                                <% if (item.student) { %>
                                    <span class="note-section-pill">Sec <%= item.student.section %></span>
                                    <span style="font-size: 0.75rem; color: var(--gray-400);">(<%= item.student.rollNumber %>)</span>
                                <% } %>
                            </div>
                            <span class="doubt-status-pill pending">⏳ Awaiting Answer</span>
                        </div>

                        <div class="doubt-subject-title">
                            📖 <%= item.subject ? `${item.subject.code} - ${item.subject.name}` : 'General Inquiry' %>
                        </div>

                        <div class="doubt-question">
                            <%= item.message %>
                        </div>

                        <form method="POST" action="/teacher/resolve-notification/<%= item._id %>" class="doubt-reply-form">
                            <input type="text" name="reply" class="doubt-reply-input" placeholder="Type answer or guidance for the student..." required>
                            <button type="submit" class="btn-resolve">
                                <span>✓ Reply & Resolve</span>
                            </button>
                        </form>
                    </div>
                <% }) %>
            <% } %>
        </div>

        <!-- TAB 2: UPLOAD NOTE -->
        <div id="tab-upload" class="tab-pane">
            <div class="glass-panel" style="max-width: 800px; margin: 0 auto;">
                <div class="panel-header">
                    <span style="font-size: 1.5rem;">📤</span>
                    <h3 class="panel-title">Upload Study Materials & Lecture Notes</h3>
                </div>

                <% if (subjects.length === 0) { %>
                    <div class="empty-box">
                        <div class="empty-box-icon">⚠️</div>
                        <h4>No subjects found</h4>
                        <p>You need to create at least one subject first before publishing notes.</p>
                    </div>
                <% } else { %>
                    <form method="POST" action="/teacher/upload-note" enctype="multipart/form-data">
                        <div class="form-grid-2">
                            <div class="form-group">
                                <label class="form-label">Course / Subject</label>
                                <select name="subjectId" class="form-control" required>
                                    <option value="">-- Choose Subject --</option>
                                    <% subjects.forEach(subject => { %>
                                        <option value="<%= subject._id %>">
                                            <%= subject.code %> — <%= subject.name %>
                                        </option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Target Section</label>
                                <select name="section" class="form-control" required>
                                    <option value="">-- Select Section --</option>
                                    <option value="A">Section A</option>
                                    <option value="B">Section B</option>
                                    <option value="C">Section C</option>
                                    <option value="D">Section D</option>
                                    <option value="E">Section E</option>
                                    <option value="All">All Sections</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Note Title</label>
                            <input type="text" name="title" class="form-control" placeholder="e.g. Chapter 3 - Binary Trees & Heaps" required>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Description / Lecture Summary</label>
                            <textarea name="description" class="form-control" rows="3" placeholder="Brief outline of topics covered in this material..."></textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Attach File (PDF, DOCX, PPTX, ZIP, Images - Max 25MB)</label>
                            <div class="file-upload-wrapper" style="border: 2px dashed var(--gray-200); padding: 1.5rem; border-radius: var(--radius-sm); text-align: center; background: var(--gray-50);">
                                <input type="file" name="file" id="note-file" style="display: none;">
                                <label for="note-file" class="file-upload-label" style="cursor: pointer; display: block; font-weight: 600; color: var(--primary);">
                                    📎 Click here to choose note file to upload
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem; background: var(--gradient-teacher);">
                            <span>🚀 Upload & Publish Note</span>
                        </button>
                    </form>
                <% } %>
            </div>
        </div>

        <!-- TAB 3: MANAGE UPLOADED NOTES -->
        <div id="tab-manage-notes" class="tab-pane">
            <div style="margin-bottom: 1.25rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--dark);">
                    Your Uploaded Study Materials (<%= notes.length %>)
                </h3>
            </div>

            <% if (notes.length === 0) { %>
                <div class="empty-box">
                    <div class="empty-box-icon">📁</div>
                    <h4>You haven't uploaded any notes yet</h4>
                    <p>Use the "Upload Note" tab to distribute study materials to your students.</p>
                </div>
            <% } else { %>
                <div class="notes-grid">
                    <% notes.forEach(note => { %>
                        <div class="note-item-card">
                            <div>
                                <div class="note-header">
                                    <span class="note-subject-pill">
                                        <%= note.subject ? `${note.subject.code} - ${note.subject.name}` : 'General' %>
                                    </span>
                                    <span class="note-section-pill">Sec <%= note.section %></span>
                                </div>
                                <h3 class="note-title"><%= note.title %></h3>
                                <p class="note-desc"><%= note.description || 'No description provided.' %></p>
                            </div>
                            <div class="note-footer">
                                <div>
                                    <span>📅 <%= new Date(note.createdAt).toLocaleDateString() %></span>
                                    <% if (note.fileType) { %>
                                        <span style="margin-left: 0.35rem; font-weight: 700; color: var(--primary);">[<%= note.fileType %>]</span>
                                    <% } %>
                                </div>
                                <div style="display: flex; gap: 0.5rem; align-items: center;">
                                    <% if (note.fileUrl) { %>
                                        <a href="<%= note.fileUrl %>" class="btn-download-note" download="<%= note.originalName || '' %>">
                                            <span>⬇️ Download</span>
                                        </a>
                                    <% } %>
                                    <form method="POST" action="/teacher/delete-note/<%= note._id %>" class="delete-confirm-form" data-title="<%= note.title %>">
                                        <button type="submit" class="btn-delete-note" title="Delete note">🗑️</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- TAB 4: TEACHING SCHEDULE -->
        <div id="tab-schedule" class="tab-pane">
            <div style="margin-bottom: 1.5rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--dark);">
                    📅 Your Assigned Class Timetable
                </h3>
                <p style="color: var(--gray-600); font-size: 0.88rem;">
                    Weekly schedule of classes and room assignments where you are assigned as the instructor.
                </p>
            </div>

            <% if (schedules.length === 0) { %>
                <div class="empty-box">
                    <div class="empty-box-icon">📅</div>
                    <h4>No classes scheduled yet</h4>
                    <p>The academic administration has not assigned timetable slots to your faculty account yet.</p>
                </div>
            <% } else { %>
                <div style="display: flex; flex-direction: column; gap: 1.25rem;">
                    <% schedules.forEach(sched => { %>
                        <div class="glass-panel" style="padding: 1.25rem; margin-bottom: 0;">
                            <h4 style="font-weight: 800; font-size: 1rem; color: var(--primary); margin-bottom: 0.75rem;">
                                🗓️ <%= sched.day %> (Section <%= sched.section %>)
                            </h4>
                            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.75rem;">
                                <% sched.slots.filter(s => s.teacher && s.teacher.toString() === user.id.toString()).forEach(slot => { %>
                                    <div style="background: var(--gray-50); border: 1.5px solid var(--gray-200); border-radius: var(--radius-sm); padding: 0.75rem;">
                                        <div style="font-weight: 800; font-size: 0.8rem; color: var(--dark);">
                                            Period <%= slot.period %> (<%= slot.startTime %> - <%= slot.endTime %>)
                                        </div>
                                        <div style="color: var(--primary); font-weight: 700; font-size: 0.9rem; margin-top: 0.25rem;">
                                            <%= slot.subject ? `${slot.subject.code} - ${slot.subject.name}` : '' %>
                                        </div>
                                        <div style="font-size: 0.8rem; color: var(--gray-600); margin-top: 0.25rem;">
                                            📍 <%= slot.room %> • Sec <%= sched.section %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% }) %>
                </div>
            <% } %>
        </div>

        <!-- TAB 5: PUBLISH RESULTS -->
        <div id="tab-results" class="tab-pane">
            <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.5rem; align-items: start;">
                <!-- Published Results Table -->
                <div class="glass-panel" style="overflow-x: auto;">
                    <h3 style="font-size: 1.15rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        Grades Published by You (<%= publishedResults.length %>)
                    </h3>
                    <% if (publishedResults.length === 0) { %>
                        <div class="empty-box">
                            <div class="empty-box-icon">📊</div>
                            <h4>No grades published yet</h4>
                            <p>Use the form to record student scores and examination results.</p>
                        </div>
                    <% } else { %>
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.88rem;">
                            <thead>
                                <tr style="text-align: left; border-bottom: 2px solid var(--gray-200); color: var(--gray-600);">
                                    <th style="padding: 0.6rem;">Student</th>
                                    <th style="padding: 0.6rem;">Course</th>
                                    <th style="padding: 0.6rem;">Exam</th>
                                    <th style="padding: 0.6rem;">Score</th>
                                    <th style="padding: 0.6rem;">Grade</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% publishedResults.forEach(r => { %>
                                    <tr style="border-bottom: 1px solid var(--gray-100);">
                                        <td style="padding: 0.6rem;">
                                            <strong><%= r.student ? r.student.name : 'Unknown' %></strong>
                                            <div style="font-size: 0.75rem; color: var(--gray-400);"><%= r.student ? r.student.rollNumber : '' %></div>
                                        </td>
                                        <td style="padding: 0.6rem;"><%= r.subject ? r.subject.code : '' %></td>
                                        <td style="padding: 0.6rem;"><%= r.examName %></td>
                                        <td style="padding: 0.6rem; font-weight: 700;"><%= r.marksObtained %> / <%= r.maxMarks %></td>
                                        <td style="padding: 0.6rem;">
                                            <span class="user-role-badge <%= r.grade === 'F' ? 'admin' : 'student' %>"><%= r.grade %></span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } %>
                </div>

                <!-- Publish Grade Form -->
                <div class="glass-panel">
                    <h4 style="font-size: 1.1rem; font-weight: 800; margin-bottom: 1rem; color: var(--dark);">
                        📊 Publish Student Grade
                    </h4>
                    <form method="POST" action="/teacher/result">
                        <div class="form-group">
                            <label class="form-label">Student Roll Number</label>
                            <input type="text" name="rollNumber" class="form-control" placeholder="e.g. S0001" required>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Course / Subject</label>
                            <select name="subjectId" class="form-control" required>
                                <option value="">-- Choose Subject --</option>
                                <% subjects.forEach(s => { %>
                                    <option value="<%= s._id %>"><%= s.code %> - <%= s.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Exam Title</label>
                            <input type="text" name="examName" class="form-control" placeholder="e.g. Mid-Term Assessment" required>
                        </div>
                        <div class="form-grid-2">
                            <div class="form-group">
                                <label class="form-label">Score</label>
                                <input type="number" step="0.5" name="marksObtained" class="form-control" placeholder="88" required>
                            </div>
                            <div class="form-group">
                                <label class="form-label">Max Marks</label>
                                <input type="number" step="1" name="maxMarks" class="form-control" value="100" required>
                            </div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Remarks</label>
                            <input type="text" name="remarks" class="form-control" placeholder="e.g. Good analytical work">
                        </div>
                        <button type="submit" class="btn-primary-glow" style="margin-top: 1rem; background: var(--gradient-teacher);">
                            Publish Grade
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- TAB 6: ADD SUBJECT -->
        <div id="tab-add-subject" class="tab-pane">
            <div class="glass-panel" style="max-width: 700px; margin: 0 auto;">
                <div class="panel-header">
                    <span style="font-size: 1.5rem;">➕</span>
                    <h3 class="panel-title">Add New Subject / Course</h3>
                </div>
                <form method="POST" action="/teacher/subject">
                    <div class="form-group">
                        <label class="form-label">Subject / Course Code</label>
                        <input type="text" name="code" class="form-control" placeholder="e.g. CS101, MATH201" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Subject Full Name</label>
                        <input type="text" name="name" class="form-control" placeholder="e.g. Advanced Operating Systems" required>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Eligible Sections (Comma Separated)</label>
                        <input type="text" name="sections" class="form-control" placeholder="e.g. A, B, C, D, E" required>
                    </div>
                    <button type="submit" class="btn-primary-glow" style="margin-top: 1rem; background: var(--gradient-teacher);">
                        <span>➕ Register Subject</span>
                    </button>
                </form>

                <div style="margin-top: 2.5rem; border-top: 1px solid var(--gray-200); padding-top: 1.5rem;">
                    <h4 style="font-size: 1rem; font-weight: 700; margin-bottom: 1rem; color: var(--dark);">
                        Your Assigned Subjects (<%= subjects.length %>)
                    </h4>
                    <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                        <% subjects.forEach(sub => { %>
                            <span class="note-subject-pill" style="padding: 0.4rem 0.8rem; font-size: 0.82rem;">
                                <%= sub.code %>: <%= sub.name %> (Sec: <%= sub.sections.join(', ') %>)
                            </span>
                        <% }) %>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 7: RESOLVED DOUBTS ARCHIVE -->
        <div id="tab-resolved" class="tab-pane">
            <div style="margin-bottom: 1.25rem;">
                <h3 style="font-size: 1.25rem; font-weight: 800; color: var(--dark);">
                    Resolved Doubts Archive (<%= resolvedDoubts.length %>)
                </h3>
            </div>

            <% if (resolvedDoubts.length === 0) { %>
                <div class="empty-box">
                    <div class="empty-box-icon">🗃️</div>
                    <h4>No resolved doubts yet</h4>
                </div>
            <% } else { %>
                <% resolvedDoubts.forEach(item => { %>
                    <div class="doubt-card">
                        <div class="doubt-header">
                            <div class="doubt-student-info">
                                <span>👤 <%= item.student ? item.student.name : 'Unknown Student' %></span>
                                <% if (item.student) { %>
                                    <span class="note-section-pill">Sec <%= item.student.section %></span>
                                <% } %>
                            </div>
                            <span class="doubt-status-pill resolved">✓ Resolved</span>
                        </div>
                        <div class="doubt-subject-title">
                            📖 <%= item.subject ? `${item.subject.code} - ${item.subject.name}` : 'General' %>
                        </div>
                        <div class="doubt-question">
                            <strong>Question:</strong> <%= item.message %>
                        </div>
                        <div class="doubt-teacher-reply-box">
                            <div style="font-weight: 700; color: var(--success-text); margin-bottom: 0.25rem;">Your Reply:</div>
                            <div><%= item.reply %></div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
