<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Student Portal Login - NotesHub</title>
    <meta name="description" content="Sign in to your student learning portal to download verified lecture notes, check weekly class schedules, and review semester examination results.">
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="alternate icon" href="/favicon.svg">

    <!-- Fonts & Stylesheet -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="page-login">
    <%- include('partials/alerts') %>

    <div class="student-page-wrap">
        <div class="student-portal-box">
            <!-- Left Hero Learning Side -->
            <div class="student-hero-side">
                <div>
                    <!-- Clickable Logo / Back link -->
                    <a href="/" class="login-back-brand" title="Return to Campus Home">
                        <span class="brand-logo-icon">📚</span>
                        <span class="brand-text">Notes<span class="brand-highlight">Hub</span></span>
                    </a>

                    <div style="font-size: 2.8rem; margin: 1.25rem 0 0.75rem;">👨‍🎓</div>
                    <h2 style="font-size: 1.85rem; font-weight: 800; line-height: 1.2; margin-bottom: 0.75rem;">
                        Student Learning Portal
                    </h2>
                    <p style="color: rgba(255,255,255,0.88); font-size: 0.92rem; line-height: 1.6;">
                        Your personalized academic gateway to verified lecture notes, weekly section timetables, semester examination grades, and direct professor doubt clearance.
                    </p>

                    <div class="student-pill-list">
                        <span class="student-chip">📥 Course Notes</span>
                        <span class="student-chip">📅 Weekly Timetable</span>
                        <span class="student-chip">📊 Semester Results</span>
                        <span class="student-chip">💬 Doubt Clearance</span>
                    </div>
                </div>

                <div class="login-left-footer">
                    <span>💡 Academic resources are automatically filtered for your enrolled section.</span>
                </div>
            </div>

            <!-- Right Login Form Side -->
            <div class="student-form-side">
                <div style="margin-bottom: 1.75rem;">
                    <span style="font-size: 0.78rem; font-weight: 700; color: #0284c7; text-transform: uppercase; letter-spacing: 0.05em;">Student Authentication</span>
                    <h3 style="font-size: 1.65rem; font-weight: 800; color: var(--dark); margin-top: 0.25rem;">Welcome Back!</h3>
                    <p style="color: var(--gray-600); font-size: 0.88rem;">Sign in with your university-issued Student Roll Number.</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="toast-alert toast-error" style="position: static; margin-bottom: 1.25rem; width: 100%;">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form method="POST" action="/login/student" id="student-form">
                    <div class="form-group">
                        <label class="form-label" for="rollNumber">Student Roll Number</label>
                        <input type="text" id="rollNumber" name="rollNumber" class="form-control" placeholder="e.g. S0001" autocomplete="username" required autofocus>
                    </div>

                    <div class="form-group">
                        <label class="form-label" for="password">Password</label>
                        <input type="password" id="password" name="password" class="form-control" placeholder="••••••••••••" autocomplete="current-password" required>
                    </div>

                    <button type="submit" class="btn-student-submit">
                        Enter Student Dashboard →
                    </button>
                </form>

                <div class="login-quick-fill-container">
                    <button type="button" class="quick-fill-chip" onclick="document.getElementById('rollNumber').value='S0001'; document.getElementById('password').value='student123';">
                        ⚡ Quick Fill Demo Student (S0001)
                    </button>
                </div>

                <div class="login-alternate-links">
                    <span>Are you an instructor? <a href="/login/teacher" class="auth-text-link">Faculty Portal →</a></span>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/main.js"></script>
</body>
</html>
