<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Login - Notes Platform</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="student-login-page">
        <div class="login-card-wrapper student-theme">
            <a href="/" class="back-link">← Back to Home</a>
            <div class="login-card">
                <div class="login-logo">
                    <div class="login-logo-icon">👨‍🎓</div>
                </div>
                <h2>Student Login</h2>
                <p class="login-subtitle">Login to access your notes</p>

                <% if (error) { %>
                    <div class="alert-modern alert-error">
                        <span>⚠️</span>
                        <span><%= error %></span>
                    </div>
                <% } %>

                <form method="POST" action="/login/student">
                    <div class="form-group-modern">
                        <label for="rollNumber">🎓 Roll Number</label>
                        <input type="text" id="rollNumber" name="rollNumber" class="form-control-modern" placeholder="Enter your roll number" required autofocus>
                    </div>
                    <div class="form-group-modern">
                        <label for="password">🔒 Password</label>
                        <input type="password" id="password" name="password" class="form-control-modern" placeholder="Enter your password" required>
                    </div>
                    <button type="submit" class="btn-login">Login as Student →</button>
                </form>

                
        </div>
    </div>
</body>
</html>
