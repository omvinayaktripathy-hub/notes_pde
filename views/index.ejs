<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NotesHub - Student Learning Platform</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <%- include('partials/navbar') %>
    <%- include('partials/alerts') %>

    <section class="welcome-hero">
        <div class="welcome-content-box">
            <div class="hero-badge">
                <span>✨</span> Student Learning & Academic Resource Hub
            </div>
            <h1 class="hero-title">Academic Notes, Timetables & Results, Simplified.</h1>
            <p class="hero-subtitle">
                Access curated lecture materials, weekly timetables, exam results, and doubt resolution customized for your academic section.
            </p>

            <div style="margin-bottom: 3.5rem;">
                <a href="/login/student" class="btn-primary-glow" style="display: inline-flex; width: auto; font-size: 1.1rem; padding: 1rem 2.5rem; text-decoration: none; border-radius: 50px;">
                    <span>Enter Student Portal</span> →
                </a>
            </div>

            <!-- Student Feature Highlights (Not Portals!) -->
            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; text-align: left;">
                <div style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-lg); padding: 1.75rem;">
                    <div style="font-size: 2.2rem; margin-bottom: 0.75rem;">📖</div>
                    <h3 style="font-size: 1.2rem; font-weight: 700; color: white; margin-bottom: 0.5rem;">Course Notes</h3>
                    <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6;">
                        Download verified study guides, lecture slides, and PDF resources directly from your faculty instructors.
                    </p>
                </div>

                <div style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-lg); padding: 1.75rem;">
                    <div style="font-size: 2.2rem; margin-bottom: 0.75rem;">📅</div>
                    <h3 style="font-size: 1.2rem; font-weight: 700; color: white; margin-bottom: 0.5rem;">Weekly Timetable</h3>
                    <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6;">
                        Keep track of your section's daily class timings, periods, lecture halls, and assigned faculty members.
                    </p>
                </div>

                <div style="background: rgba(30, 41, 59, 0.7); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: var(--radius-lg); padding: 1.75rem;">
                    <div style="font-size: 2.2rem; margin-bottom: 0.75rem;">📊</div>
                    <h3 style="font-size: 1.2rem; font-weight: 700; color: white; margin-bottom: 0.5rem;">Exam Results</h3>
                    <p style="color: #94a3b8; font-size: 0.88rem; line-height: 1.6;">
                        Check your semester examination grades, subject scores, and faculty evaluation remarks in real time.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <script src="/js/main.js"></script>
</body>
</html>
