<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Notes Platform - Welcome</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="welcome-page">
        <div class="welcome-container">
            <div class="welcome-logo">📚</div>
            <h1>Welcome to Notes Platform</h1>
            <p class="welcome-subtitle">Choose how you want to continue</p>

            <div class="role-cards">
                <!-- Student Card -->
                <a href="/login/student" class="role-card student-card">
                    <div class="role-card-icon">👨‍🎓</div>
                    <h2>Student</h2>
                    <p>Access notes, download materials, ask doubts</p>
                    <span class="role-btn">Login as Student →</span>
                </a>

                <!-- Teacher Card -->
                <a href="/login/teacher" class="role-card teacher-card">
                    <div class="role-card-icon">👨‍🏫</div>
                    <h2>Teacher</h2>
                    <p>Upload notes, manage subjects, resolve doubts</p>
                    <span class="role-btn">Login as Teacher →</span>
                </a>
            </div>
        </div>
    </div>
</body>
</html>
