# Environment Mode: development | production
NODE_ENV=production

# Database Connection URL (Local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/notes_platform

# Express Session Encryption Secret (Use 64+ random characters in production)
SESSION_SECRET=your_random_secret_session_key_here_change_in_prod

# Application Port
PORT=3000

# Allowed CORS Origins (comma-separated list for production)
ALLOWED_ORIGINS=https://notes.yourcampus.edu,https://admin.yourcampus.edu

# CAPTCHA Bot Protection Secret (Cloudflare Turnstile or Google reCAPTCHA)
CAPTCHA_SECRET_KEY=

# Webhook Signature Secret (for validating external incoming webhooks)
WEBHOOK_SECRET=
